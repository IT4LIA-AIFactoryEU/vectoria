# Copy to .env and replace the placeholders. Never commit the populated .env.
# Keep assignments shell-compatible: no spaces around '='; quote values containing spaces.
# The host application reads .env automatically. Export it before running Ansible:
#   set -a; source .env; set +a

# Upstream LLM: an OpenAI-compatible endpoint with tool-call support.
# Include /v1 in the URL. This is NOT Vectoria's own /v1 endpoint.
LLM_PROVIDER=custom
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=replace-with-endpoint-key
LLM_MODEL=replace-with-served-model-name
LLM_TIMEOUT=120
# Docker reaching an LLM on the host: use http://host.docker.internal:11434/v1.
# If the server does not authenticate requests, use a nonempty dummy key.

# Vectoria authentication (different from the upstream LLM key).
# Empty disables token checks. Otherwise clients must send x-token.
# Browser upload and standard OpenWebUI Bearer keys do not send this header.
PERMITTED_KEYS=

# Docker Compose paths and ports. Relative paths are relative to the repository.
DATA_DIR=./data
CONFIG_PATH=etc/docker/config.yaml
VECTORIA_PORT=8000
OPENWEBUI_PORT=8080
# HF_CACHE_DIR=/absolute/path/to/huggingface-cache
# OPENWEBUI_DATA_DIR=./data/openwebui
# MODELS_DIR=/absolute/path/to/gguf-models
# LLAMA_SERVER_DIR=/absolute/path/to/llama.cpp/build/bin
# INDEX_PATH=/data/index/default
# QDRANT_API_KEY=replace-with-qdrant-key
# HF_TOKEN=replace-with-huggingface-token

# Optional MLflow. Start the observability Compose profile as well.
# Docker backend: http://mlflow:5000; host backend: http://localhost:5000.
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_PORT=5000

# Alternative provider selection for HOST execution only. Supplied Compose does
# not forward LLM_PROVIDER or these provider-specific variables into the container.
# Set LLM_MODEL for the chosen provider; use etc/local/config.yaml on the host.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-openai-key
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-anthropic-key
# LLM_PROVIDER=google
# GOOGLE_API_KEY=replace-with-google-key
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# VECTORIA_ALLOWED_ORIGINS=http://localhost:8080

# Leonardo / CINECA: uncomment and populate when deploying with Ansible.
# The current automatic tunnel task uses ~/.ssh/cineca_key even if another
# CINECA_SSH_KEY is supplied. Use that identity for the documented automatic flow.
# CINECA_USER=your-cineca-username
# CINECA_SSH_KEY=/absolute/path/to/.ssh/cineca_key
# ANSIBLE_HPC_ACCOUNT=your-allocation-account
# VECTORIA_API_TOKEN=replace-with-a-long-random-token
# CINECA_EMAIL=your-email-address
# CINECA_EMAIL is required by etc/hpc/leonardo_connect.sh, not deploy.yml.
# VECTORIA_REPO_URL is not needed by the current deployment (it syncs this checkout).
