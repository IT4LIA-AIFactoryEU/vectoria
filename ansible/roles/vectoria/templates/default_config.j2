# ─────────────────────────────────────────────────────────────────────────────
# This is one of Vectoria's two configuration sources (the other is
# etc/docker/config.yaml, used for local/Docker). If you change any of
# these shared sections, update the other file too:
#   agent_guardrails, wiki, graph_store, full_paragraphs_retriever,
#   and the non-path parts of chat_history / reranker / data_ingestion.
# ─────────────────────────────────────────────────────────────────────────────
# Vectoria HPC configuration — generated by Ansible
# Edit vars/config.yml and re-run the playbook to regenerate.

vectoria_logs_dir: ~/vectoria_logs
log_level: {{ log_level }}
system_prompts_lang: {{ system_prompts_lang }}

data_ingestion:
  multiprocessing: {{ data_ingestion_multiprocessing | lower }}
  multiprocessing_workers: {{ data_ingestion_multiprocessing_workers }}

  extraction:
    format: pdf
    backend: {{ extraction_backend }}      # pypdf first (fast, digital PDFs); falls back to docling+OCR for scans
    dump_doc_structure_on_file: {{ dump_doc_structure_on_file | lower }}
    regexes_for_metadata_extraction:
      - name: DOC_ID
        pattern: '^Document Title'

  regexes_for_replacement:
    - name: remove_multiple_spaces
      pattern: '[ \t]{2,}'
      replace_with: ' '
    - name: remove_bullets
      pattern: '^\s*[\u2022\u25AA\u27A2]\s*'
      replace_with: ''
    - name: remove_ligature_st
      pattern: 'ﬆ'
      replace_with: 'st'
    - name: replace_fi
      pattern: 'ﬁ'
      replace_with: 'fi'
    - name: replace_fl
      pattern: 'ﬂ'
      replace_with: 'fl'
    - name: replace_ffi
      pattern: 'ﬃ'
      replace_with: 'ffi'
    - name: replace_ffl
      pattern: 'ﬄ'
      replace_with: 'ffl'
    - name: replace_ft
      pattern: 'ﬅ'
      replace_with: 'ft'

  chunking:
    method: {{ chunking_method }}   # "recursive" (fixed-size) or "semantic" (topic-aware)
    chunk_overlap: {{ chunk_overlap }}
    dump_chunks_on_file: {{ dump_chunks_on_file | lower }}
    tokenizer_name: {{ embedding_model }}
    # Semantic chunking options:
    # semantic_embedding_model: {{ embedding_model }}  # defaults to vector_store.model_name
    semantic_device: "${VECTORIA_COMPUTE_DEVICE}"
    semantic_breakpoint_threshold_type: {{ semantic_breakpoint_threshold_type }}
    semantic_breakpoint_threshold_amount: {{ semantic_breakpoint_threshold_amount }}
    semantic_max_chunk_size: {{ semantic_max_chunk_size }}
{% if chunking_method == 'recursive' %}
    # Recursive chunking options:
    chunk_size: {{ chunk_size }}
    separators: ["\n\n", "\n", " ", ""]
    is_separator_regex: [false, false, false, false]
{% endif %}

vector_store:
  name: {{ vector_store_name }}
  model_name: {{ embedding_model }}
  device: "${VECTORIA_COMPUTE_DEVICE}"
  normalize_embeddings: {{ vector_store_normalize_embeddings | lower }}
  collection_name: {{ vector_store_collection_name }}
  embedding_batch_size: {{ vector_store_embedding_batch_size }}

retriever:
  enabled: true
  top_k: {{ retriever_top_k }}
  search_type: {{ retriever_search_type }}
  bm25_weight: {{ retriever_bm25_weight }}
  multi_query: {{ retriever_multi_query | lower }}
  min_per_source: {{ retriever_min_per_source }}
  mmr_enabled: {{ retriever_mmr_enabled | lower }}
  mmr_lambda: {{ retriever_mmr_lambda }}
  mmr_top_k: {{ retriever_mmr_top_k }}

reranker:
  enabled: {{ reranker_enabled | lower }}
  reranked_top_k: {{ reranker_top_k }}
  model_name: {{ reranker_model }}
  device: "${VECTORIA_COMPUTE_DEVICE}"

full_paragraphs_retriever:
  enabled: {{ full_paragraphs_retriever_enabled | lower }}

chat_history:
  enabled: {{ chat_history_enabled | lower }}
  summarize_after_n_messages: {{ chat_history_summarize_after_n_messages }}
  max_conv_messages: {{ chat_history_max_conv_messages }}
  max_tool_messages: {{ chat_history_max_tool_messages }}
  checkpoint_db_path: "{{ scratch_resolved.stdout }}/vectoria_data/chat_history.db"
  summary_llm:
    name: openai
    base_url: http://localhost:{{ vllm_port }}/v1
    api_key: "{{ api_token }}"
    model_name: {{ llm_model }}
    temperature: {{ chat_history_summary_temperature }}
    max_tokens: {{ chat_history_summary_max_tokens }}

agent_guardrails:
  tool_call_limit:
    enabled: {{ tool_call_limit_enabled | lower }}
    run_limit: {{ tool_call_limit }}
    thread_limit: {{ 'null' if tool_call_thread_limit is none else tool_call_thread_limit }}
    exit_behavior: {{ tool_call_exit_behavior }}
  human_approval:
    enabled: {{ human_approval_enabled | lower }}
    tools: {{ human_approval_tools }}

inference_engine:
  name: openai
  base_url: http://localhost:{{ vllm_port }}/v1
  api_key: "{{ api_token }}"
  model_name: {{ llm_model }}
  temperature: {{ inference_temperature }}
  max_tokens: {{ inference_max_tokens }}
  streaming: {{ inference_streaming | lower }}
  request_timeout: {{ inference_request_timeout }}
  model_kwargs:
    extra_body:
      chat_template_kwargs:
        enable_thinking: {{ vllm_enable_thinking | lower }}

llama_server:
  enabled: false   # docker-only local inference alternative; HPC always serves via vLLM

{% if graph_enabled | default(false) %}
graph_store:
  enabled: true
  extraction_device: "${VECTORIA_COMPUTE_DEVICE}"
  model_path: "{{ scratch_resolved.stdout }}/hf_vectoria/gliner_model"
  entity_types: null
  min_entity_confidence: {{ graph_min_entity_confidence }}
  min_count: {{ graph_min_count }}
  min_pmi: {{ graph_min_pmi }}                     # scarta archi rumorosi (hub vs co-occorrenze rare)
  relation_method: {{ graph_relation_method }}
  relation_extraction: {{ graph_relation_extraction | lower }}       # false = usa spaCy gratis; true = LLM batched
  relation_min_count: {{ graph_relation_min_count }}
  relation_batch_size: {{ graph_relation_batch_size }}
  spacy_model: {{ spacy_model }}
  entity_resolution: {{ graph_entity_resolution | lower }}          # unifica 'mario rossi' ≡ 'mario r.'
  resolution_threshold: {{ graph_resolution_threshold }}
{% endif %}

wiki:
  enabled: {{ wiki_enabled | lower }}
  pending_threshold: {{ wiki_pending_threshold }}
  max_topics_per_doc: {{ wiki_max_topics_per_doc }}
  max_topics_per_batch: {{ wiki_max_topics_per_batch }}
  language_normalization: {{ wiki_language_normalization | lower }}
  similarity_threshold: {{ wiki_similarity_threshold }}
  canonical_topic_language: {{ system_prompts_lang | replace('eng', 'en') | replace('ita', 'it') }}
  synthesis_context_chunks: {{ wiki_synthesis_context_chunks }}
  max_page_words: {{ wiki_max_page_words }}

