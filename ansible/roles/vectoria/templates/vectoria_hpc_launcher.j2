#!/bin/bash
# Generated by Ansible — edit vars/config.yml and re-run deploy.yml to regenerate.

#SBATCH --job-name=vectoria_hpc
#SBATCH --time={{ job_time }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --qos={{ qos }}
#SBATCH --nodes={{ nodes }}
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task={{ cpus }}
#SBATCH --gres=gpu:{{ gpus }}
#SBATCH --error vectoria_hpc-%j.err
#SBATCH --output vectoria_hpc-%j.out

{% if nodes | int > 1 %}
### Multi-node mode: vLLM TP={{ (nodes | int) * (gpus | int) }} on all {{ (nodes | int) * (gpus | int) }} GPUs — Vectoria on CPU ###
{% else %}
### Single-node mode: vLLM TP={{ vllm_tensor_parallel_single }} on GPU {{ vllm_gpus }} — Vectoria on GPU {{ vectoria_gpus }} ###
{% endif %}

# ── Paths ──────────────────────────────────────────────────────────────────────
VECTORIA_DIR="{{ vectoria_dir }}"
INDEX_DIR="{{ scratch_resolved.stdout }}/vectoria_data/index"
UPLOAD_DIR="{{ scratch_resolved.stdout }}/vectoria_data/uploads"
VECTORIA_PORT={{ vectoria_port }}
OPENWEBUI_PORT={{ openwebui_node_port }}
OPENWEBUI_DATA="{{ openwebui_data_dir }}"

# ── Models / Auth ──────────────────────────────────────────────────────────────
API_TOKEN="{{ api_token }}"
MODEL_PATH="{{ llm_model }}"
IMAGE_PATH="{{ image_path }}"
OPENWEBUI_IMAGE="{{ openwebui_image_path }}"

# ── HuggingFace caches ─────────────────────────────────────────────────────────
export HF_HOME="{{ hf_models_dir }}"
export HF_HUB_CACHE="{{ hf_models_dir }}/hub"
export HF_HUB_OFFLINE="1"

# ── NCCL (InfiniBand) ──────────────────────────────────────────────────────────
export NCCL_IB_HCA="mlx5"
export NCCL_SOCKET_IFNAME="ib0"

# ── Node info ──────────────────────────────────────────────────────────────────
worker_list=($(scontrol show hostnames "$SLURM_JOB_NODELIST"))
head_node=${worker_list[0]}
head_node_ip=$(srun --nodes=1 --ntasks=1 -w "$head_node" hostname --ip-address)
headnode_ip_ib=$(srun --nodes=1 --ntasks=1 -w "$head_node" ip -4 addr show ib0 | awk '/inet / {print $2}' | cut -d/ -f1)
echo "[INFO]: head node $head_node — IP $head_node_ip — IB $headnode_ip_ib"

mkdir -p "$INDEX_DIR" "$UPLOAD_DIR"

# ── Locate chat template inside container ──────────────────────────────────────
echo "[INFO]: Locating {{ vllm_tool_call_parser }} chat template..."
CHAT_TEMPLATE_PATH=$(singularity exec "$IMAGE_PATH" \
  find / -name "tool_chat_template_{{ vllm_tool_call_parser }}.jinja" 2>/dev/null | head -1)
CHAT_TEMPLATE_FLAG=""
[ -n "$CHAT_TEMPLATE_PATH" ] && CHAT_TEMPLATE_FLAG="--chat-template $CHAT_TEMPLATE_PATH"

# ── Command fragments ──────────────────────────────────────────────────────────
singularity_bind="--bind /leonardo_scratch:/leonardo_scratch,/leonardo_work:/leonardo_work"
singularity_cmd="singularity exec --nv $singularity_bind $IMAGE_PATH bash -l -c"

# Single-node vLLM command (used only when nodes=1)
vllm_cmd="CUDA_VISIBLE_DEVICES={{ vllm_gpus }} HF_HUB_OFFLINE=1 \
  vllm serve $MODEL_PATH \
    --host 0.0.0.0 \
    --port {{ vllm_port }} \
    --tensor-parallel-size {{ vllm_tensor_parallel_single }} \
    --api-key $API_TOKEN \
    --enable-auto-tool-choice \
    --tool-call-parser {{ vllm_tool_call_parser }} \
    --reasoning-parser {{ vllm_tool_call_parser }} \
    --limit-mm-per-prompt '{\"image\": {{ vllm_max_images_per_prompt | default(5) }}}' \
    --gpu-memory-utilization {{ vllm_gpu_memory_utilization | default(0.90) }} \
    $CHAT_TEMPLATE_FLAG\
{% if vllm_enforce_eager | default(false) %}    --enforce-eager \
{% endif %}{% if vllm_disable_custom_all_reduce | default(false) %}    --disable-custom-all-reduce \
{% endif %}{% if vllm_trust_remote_code %}    --trust-remote-code \
{% endif %}    "

# ── Start vLLM ────────────────────────────────────────────────────────────────
{% if nodes | int > 1 %}
RAY_VENV="${SCRATCH}/ray_venv"
RAY_BIN="$RAY_VENV/bin/ray"
echo "[INFO]: Multi-node mode ({{ nodes }} nodes, TP={{ (nodes | int) * (gpus | int) }}) — creating overlays..."
for i in $(seq 0 $(( {{ nodes }} - 1 ))); do
  OVL="${SCRATCH}/vectoria_overlay_${i}.img"
  rm -f "$OVL"
  singularity overlay create --sparse --size 16000 "$OVL"
done

# Ray sees all GPUs on each node; vLLM spans all {{ (nodes | int) * (gpus | int) }} GPUs via TP
ray_head_cmd="$RAY_BIN start --head \
  --node-ip-address=$head_node_ip \
  --port={{ ray_port }} \
  --num-cpus=$SLURM_CPUS_PER_TASK \
  --num-gpus={{ gpus }} \
  --disable-usage-stats \
  --block"

vllm_multi_cmd="HF_HUB_OFFLINE=1 \
  $RAY_VENV/bin/python -m vllm.entrypoints.cli.main serve $MODEL_PATH \
    --host 0.0.0.0 \
    --port {{ vllm_port }} \
    --tensor-parallel-size {{ (nodes | int) * (gpus | int) }} \
    --api-key $API_TOKEN \
    --distributed-executor-backend ray \
    --enable-auto-tool-choice \
    --tool-call-parser {{ vllm_tool_call_parser }} \
    --reasoning-parser {{ vllm_tool_call_parser }} \
    --limit-mm-per-prompt '{\"image\": {{ vllm_max_images_per_prompt | default(5) }}}' \
    --gpu-memory-utilization {{ vllm_gpu_memory_utilization | default(0.90) }} \
    $CHAT_TEMPLATE_FLAG\
{% if vllm_enforce_eager | default(false) %}    --enforce-eager \
{% endif %}{% if vllm_disable_custom_all_reduce | default(false) %}    --disable-custom-all-reduce \
{% endif %}{% if vllm_trust_remote_code %}    --trust-remote-code \
{% endif %}    "

echo "[INFO]: Starting Ray head + vLLM on $head_node..."
srun --nodes=1 --ntasks=1 -w "$head_node" \
  singularity exec --nv $singularity_bind \
    --env PYTHONNOUSERSITE=1 \
    --overlay "${SCRATCH}/vectoria_overlay_0.img" \
    "$IMAGE_PATH" bash -c \
  "$ray_head_cmd & until $RAY_BIN status --address=localhost:{{ ray_port }} 2>/dev/null; do echo '[INFO]: Waiting for Ray GCS...'; sleep 15; done && $vllm_multi_cmd" &

for i in "${!worker_list[@]}"; do
  [[ $i -eq 0 ]] && continue
  worker="${worker_list[$i]}"
  ray_worker_cmd="$RAY_BIN start \
    --address=$head_node_ip:{{ ray_port }} \
    --num-cpus=$SLURM_CPUS_PER_TASK \
    --num-gpus={{ gpus }} \
    --disable-usage-stats \
    --block"
  echo "[INFO]: Starting Ray worker on $worker..."
  srun --nodes=1 --ntasks=1 -w "$worker" \
    singularity exec --nv $singularity_bind \
      --env PYTHONNOUSERSITE=1 \
      --overlay "${SCRATCH}/vectoria_overlay_${i}.img" \
      "$IMAGE_PATH" bash -c \
    "$ray_worker_cmd" &
done

{% else %}
echo "[INFO]: Starting vLLM on GPUs {{ vllm_gpus }} (TP={{ vllm_tensor_parallel_single }})..."
srun --nodes=1 --ntasks=1 -w $head_node $singularity_cmd "$vllm_cmd" &
{% endif %}

# ── Wait for vLLM ─────────────────────────────────────────────────────────────
echo "[INFO]: Waiting for vLLM (may take 6-8 min)..."
_vllm_wait=0
until curl -s -H "Authorization: Bearer $API_TOKEN" \
      http://localhost:{{ vllm_port }}/v1/models > /dev/null 2>&1; do
  sleep 15
  _vllm_wait=$(( _vllm_wait + 15 ))
  if [ "$_vllm_wait" -ge 1800 ]; then
    echo "[ERROR]: vLLM did not become ready within 30 min — aborting." >&2
    exit 1
  fi
done
echo "[INFO]: vLLM is ready (after ${_vllm_wait}s)!"

# ── Start Vectoria ─────────────────────────────────────────────────────────────
{% if nodes | int > 1 %}
echo "[INFO]: Starting Vectoria on CPU (multi-node: all GPUs reserved for vLLM)..."
VECTORIA_CUDA_DEVICES="-1"
VECTORIA_COMPUTE_DEVICE_VAL="cpu"
{% else %}
echo "[INFO]: Starting Vectoria on GPUs {{ vectoria_gpus }}..."
VECTORIA_CUDA_DEVICES="{{ vectoria_gpus }}"
VECTORIA_COMPUTE_DEVICE_VAL="cuda"
{% endif %}
cd "$VECTORIA_DIR"
source .venv/bin/activate
CUDA_VISIBLE_DEVICES=$VECTORIA_CUDA_DEVICES \
VECTORIA_COMPUTE_DEVICE=$VECTORIA_COMPUTE_DEVICE_VAL \
VECTORIA_CONFIG_FILE=etc/hpc/default_config.yaml \
HF_HOME="{{ hf_vectoria_cache }}" \
HF_HUB_CACHE="{{ hf_vectoria_cache }}/hub" \
HF_HUB_OFFLINE=1 \
  python bin/vectoria \
    --config etc/hpc/default_config.yaml serve \
    --index-dir  "$INDEX_DIR" \
    --upload-dir "$UPLOAD_DIR" \
    --upload-url "http://localhost:{{ vectoria_local_port }}/upload" \
    --host 0.0.0.0 \
    --port "$VECTORIA_PORT" &
deactivate

# ── Start OpenWebUI ───────────────────────────────────────────────────────────
echo "[INFO]: Starting OpenWebUI on port $OPENWEBUI_PORT..."
mkdir -p "$OPENWEBUI_DATA"
export SINGULARITYENV_PORT=$OPENWEBUI_PORT
export SINGULARITYENV_HOST=0.0.0.0
export SINGULARITYENV_WEBUI_SECRET_KEY="{{ api_token }}-openwebui-secret-key-hpc"
export SINGULARITYENV_WEBUI_AUTH=False
export SINGULARITYENV_DATA_DIR=/app/backend/data
export SINGULARITYENV_HF_HOME="{{ hf_vectoria_cache }}"
export SINGULARITYENV_HF_HUB_CACHE="{{ hf_vectoria_cache }}/hub"
export SINGULARITYENV_HF_HUB_OFFLINE=1
export SINGULARITYENV_TRANSFORMERS_OFFLINE=1
export SINGULARITYENV_SENTENCE_TRANSFORMERS_HOME="{{ hf_vectoria_cache }}/hub"
export SINGULARITYENV_RAG_EMBEDDING_MODEL="{{ embedding_model }}"
export SINGULARITYENV_OPENAI_API_BASE_URLS=http://localhost:{{ vectoria_port }}/v1
export SINGULARITYENV_OPENAI_API_KEYS=$API_TOKEN
export SINGULARITYENV_ENABLE_OLLAMA_API=false
export SINGULARITYENV_ENABLE_SIGNUP=True
export SINGULARITYENV_ENABLE_RAG_LOCAL_WEB_FETCH=False
export SINGULARITYENV_ENABLE_RAG_WEB_SEARCH=False
export SINGULARITYENV_ENABLE_RETRIEVAL_QUERY_GENERATION=False
export SINGULARITYENV_ENABLE_TITLE_GENERATION=False
export SINGULARITYENV_ENABLE_FOLLOW_UP_GENERATION=False
export SINGULARITYENV_ENABLE_TAGS_GENERATION=False
export SINGULARITYENV_ENABLE_AUTOCOMPLETE_GENERATION=False
export SINGULARITYENV_AUDIO_STT_ENGINE=openai
export SINGULARITYENV_AUDIO_TTS_ENGINE=openai

ST_MODEL_DIR="{{ hf_vectoria_cache }}/hub/models--{{ embedding_model | replace('/', '--') }}"
if [ -d "$ST_MODEL_DIR" ]; then
  echo "[INFO]: HF cache present for {{ embedding_model }} at $ST_MODEL_DIR"
else
  echo "[WARN]: HF cache MISSING for {{ embedding_model }} — re-run download_LLMs.yml"
fi

singularity exec \
  --pwd /app/backend \
  --bind "$OPENWEBUI_DATA:/app/backend/data" \
  --bind "{{ hf_vectoria_cache }}:{{ hf_vectoria_cache }}" \
  "$OPENWEBUI_IMAGE" bash -c "export PORT=$OPENWEBUI_PORT HOST=0.0.0.0 && exec bash start.sh" &

# ── Tunnel instructions ────────────────────────────────────────────────────────
echo "=========================================================="
echo "[INFO]: Open SSH tunnels from your PC with:"
echo "  ./etc/hpc/leonardo_connect.sh vectoria"
echo ""
echo "  Vectoria API: http://localhost:{{ vectoria_local_port }}"
echo "  OpenWebUI:    http://localhost:{{ openwebui_local_port }}"
{% if nodes | int > 1 %}
echo "  Ray dashboard: http://localhost:{{ ray_webui_local_port }}"
{% endif %}
echo "=========================================================="

sleep infinity
